# Host-side path containing the published website content.
# This directory must exist and be writable by the content publisher.
WWWEE_CONTENT_PATH=/path/to/wwwee/content

# Host-side TLS certificate and private-key paths.
# These are used when direct HTTPS is enabled in docker-compose.yml.
WWWEE_TLS_CERT_PATH=/path/to/tls/tls.crt
WWWEE_TLS_KEY_PATH=/path/to/tls/tls.key
