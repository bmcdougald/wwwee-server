{
  "schema": 1,
  "setup": [
    {
      "name": "Rebuild application npm dependencies",
      "cwd": "test",
      "argv": ["npm", "rebuild"]
    },
    {
      "name": "Install Playwright Chromium and system dependencies",
      "cwd": "test",
      "argv": ["npm", "run", "playwright:install"],
      "suite": "browser"
    }
  ],
  "tests": [
    {
      "name": "CI suite routing regression tests",
      "cwd": ".",
      "argv": ["{base_python}", ".quality/tests/test_ci.py"],
      "suite": "general"
    },
    {
      "name": "OpenSCAP compliance scan",
      "cwd": ".",
      "argv": ["bash", "scripts/openscap-scan.sh"],
      "suite": "openscap"
    },
    {
      "name": "HTTP integration tests",
      "cwd": "test",
      "argv": ["npm", "run", "test", "--", "tests/health.test.ts"],
      "suite": "general"
    },
    {
      "name": "Playwright browser tests",
      "cwd": "test",
      "argv": ["npm", "run", "test", "--", "tests/landing.test.ts"],
      "suite": "browser"
    }
  ],
  "timeout_seconds": 1800
}
